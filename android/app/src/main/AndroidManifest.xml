<?xml version="1.0" encoding="utf-8"?>
<!--
  Parte 12 — Permisos Android.

  Este manifiesto asume el scaffold estándar generado por `flutter create`
  (mismo <application>/<activity> que trae cualquier proyecto Flutter
  nuevo); lo único añadido a propósito para "Vende Móvil" son los permisos
  y <uses-feature> de cámara/Bluetooth que pide la Parte 12 del prompt.
  Si ya tienes un AndroidManifest.xml propio, basta con copiar el bloque
  de <uses-permission>/<uses-feature> de aquí adentro del tuyo.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cámara: lectura continua de códigos de barra (Parte 2, 4 y 5). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Bluetooth clásico (SPP) para la impresora térmica ESC/POS (Parte 8 y
      10). BLUETOOTH y BLUETOOTH_ADMIN cubren Android <= 11 (API <= 30);
      BLUETOOTH_CONNECT y BLUETOOTH_SCAN son los equivalentes nuevos que
      exige Android 12+ (API 31+).
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      `usesPermissionFlags="neverForLocation"` le dice a Android 12+ que el
      escaneo Bluetooth de esta app nunca se usa para inferir ubicación
      (solo buscamos la impresora térmica), así en API 31+ NO hace falta
      pedir además ACCESS_FINE_LOCATION. En versiones más viejas de
      Android, algunos paquetes de Bluetooth clásico sí necesitan
      ubicación para poder escanear dispositivos, así que se declara aparte
      limitada a esas versiones con `maxSdkVersion`.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!--
      Declara que la app usa cámara y Bluetooth pero no son estrictamente
      obligatorios a nivel de dispositivo (`required="false"`) para no
      bloquear la publicación en tablets/equipos sin esas features; la app
      igual controla en tiempo de ejecución qué hacer si faltan
      (Catálogo manual sin cámara, métodos de pago sin impresión, etc).
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application
        android:label="Vende Móvil"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!--
              Tema mostrado mientras Flutter arranca (splash), reemplazado
              por normal_theme apenas Flutter dibuja el primer frame. Viene
              del scaffold estándar de `flutter create`.
            -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Requerido por el embedding de Flutter (plugins, generated_plugin_registrant, etc). -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

</manifest>
